{
  "expo": {
    "name": "TailorFlow",
    "slug": "tailorflow",
    "icon": "./assets/tailorflow-adaptive-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tailorflow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.tailorflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tailorflow-adaptive-icon.png",
        "backgroundColor": "#677356"
      }
    },
    "ios": {
      "bundleIdentifier": "com.tailorflow.app",
      "supportsTablet": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5921703-18a2-417a-b11b-55a1061eb129"
      }
    }
  }
}
