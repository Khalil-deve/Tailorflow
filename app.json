{
  "expo": {
    "name": "TailorFlow",
    "slug": "tailorflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tailorflow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true },
    "android": { "package": "com.tailorflow.app", "adaptiveIcon": { "backgroundColor": "#677356" } },
    "ios": { "bundleIdentifier": "com.tailorflow.app", "supportsTablet": true }
  }
}
